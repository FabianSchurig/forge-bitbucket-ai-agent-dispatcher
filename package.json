{
  "name": "forge-bitbucket-ai-agent-dispatcher",
  "version": "1.0.0",
  "description": "Atlassian Forge App – Bitbucket AI Agent Dispatcher. Listens for trigger keywords in PR comments and dispatches a custom pipeline in a central hub repository.",
  "license": "AGPL-3.0-or-later",
  "main": "src/index.ts",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "scan": "npx --yes osv-scanner@latest scan source --config=osv-scanner.toml --lockfile=package-lock.json",
    "audit:runtime": "npm audit --omit=dev --audit-level=critical",
    "deploy": "forge deploy",
    "install:app": "forge install"
  },
  "dependencies": {
    "@forge/api": "^8.0.4",
    "@forge/kvs": "^2.0.4",
    "@forge/react": "^12.1.2",
    "@forge/resolver": "^2.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@forge/cli": "^13.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
