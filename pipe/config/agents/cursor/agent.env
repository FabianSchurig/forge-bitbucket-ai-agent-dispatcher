# Cursor profile runtime settings.
#
# Sourced by provision.sh and execute.sh inside the agent image. Each value is
# overridable from the environment.

AGENT_COMMAND="${AGENT_COMMAND:-cursor-agent}"
# execute.sh passes -p (print mode) and the prompt itself. The container is the
# sandbox, so Cursor's own sandbox is disabled: it relies on kernel features a
# BuildKit RUN does not grant.
AGENT_FLAGS="${AGENT_FLAGS:---force --trust --approve-mcps --sandbox disabled --output-format stream-json}"
AGENT_MODEL="${AGENT_MODEL:-${CURSOR_MODEL:-claude-opus-5-5-high}}"

# stream-json is one event per line. Reduce it to a readable trace: one line
# per tool call, then the final answer verbatim, so the log shows what the
# agent actually did and the result stays greppable.
AGENT_OUTPUT_FILTER='if .type == "tool_call" and .subtype == "started" then "  tool> " + ((.tool_call | tostring)[0:400]) elif .type == "result" then (.result // "") else empty end'

# Printed before the run so the log records which models and MCP servers the
# agent could see.
AGENT_LIST_MODELS_COMMAND="cursor-agent --list-models"
AGENT_PREFLIGHT_COMMAND="cursor-agent mcp list"

# Secret the agent authenticates with, read from /run/secrets/<name>.
# cursor-agent picks CURSOR_API_KEY up from the environment.
AGENT_SECRET_NAME="CURSOR_API_KEY"

# Paths relative to the container user's home.
AGENT_HOME_DIR=".cursor"
AGENT_SKILLS_DIR=".agents/skills"
AGENT_MCP_CONFIG_PATH=".cursor/mcp.json"

# Cursor has no user-level instructions file, so the profile instructions are
# prepended to the prompt.
AGENT_INSTRUCTIONS_FILE="cursor-instructions.md"
AGENT_INSTRUCTIONS_PATH=""

# Pinned so a rebuild of an old agent image installs the same CLI.
CURSOR_CLI_VERSION="${CURSOR_CLI_VERSION:-2026.10.22-27dcf5f}"
