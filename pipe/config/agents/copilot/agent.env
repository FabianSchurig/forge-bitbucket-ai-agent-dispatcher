# Copilot profile runtime settings.
#
# Sourced by execute.sh inside the agent image. Each value is overridable from
# the environment so a caller can pass a model through as a build arg without
# having to ship a second profile.

AGENT_COMMAND="${AGENT_COMMAND:-copilot}"
AGENT_FLAGS="${AGENT_FLAGS:---allow-all-tools --output-format json --no-ask-user}"
AGENT_MODEL="${AGENT_MODEL:-${COPILOT_MODEL:-}}"
