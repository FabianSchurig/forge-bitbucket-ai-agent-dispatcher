# Copilot profile runtime settings.
#
# Sourced by provision.sh and execute.sh inside the agent image. Each value is
# overridable from the environment so a caller can pass a model through as a
# build arg without having to ship a second profile.

AGENT_COMMAND="${AGENT_COMMAND:-copilot}"
AGENT_FLAGS="${AGENT_FLAGS:---allow-all-tools --output-format json --no-ask-user}"
AGENT_MODEL="${AGENT_MODEL:-${COPILOT_MODEL:-}}"

# Secret the agent authenticates with, read from /run/secrets/<name>.
AGENT_SECRET_NAME="COPILOT_GITHUB_TOKEN"

# Paths relative to the container user's home.
AGENT_HOME_DIR=".copilot"
AGENT_SKILLS_DIR=".copilot/skills"
AGENT_MCP_CONFIG_PATH=".copilot/mcp-config.json"

# Profile instructions: copied to AGENT_INSTRUCTIONS_PATH when set, otherwise
# prepended to the prompt.
AGENT_INSTRUCTIONS_FILE="copilot-instructions.md"
AGENT_INSTRUCTIONS_PATH=".copilot/copilot-instructions.md"
